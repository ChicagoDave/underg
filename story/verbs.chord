  phrase carried-can when the player holds the gold garbage can
  phrase carried-dish when the player holds the gold pet's dish
  phrase carried-silver when the player holds the Gnomes' silver
  phrase carried-diamonds when the player holds the large diamonds
  phrase carried-telescope when the player holds the gold telescope
  phrase carried-emerald when the player holds the large emerald
  phrase carried-coins when the player holds the rare coins
  phrase carried-stamps when the player holds the rare stamps
  phrase carried-pearl when the player holds the black pearl
  phrase carried-key when the player holds the golden key
  phrase carried-leash when the player holds the cat's leash
  phrase carried-lamp when the player holds the electric lamp
  phrase carried-bottle when the player holds the glass bottle
  phrase carried-water when the player holds the water
  phrase carried-sunglasses when the player holds the sunglasses
  phrase carried-rock when the player holds the rock
  phrase carried-pistol when the player holds the laser pistol
  phrase carried-coal when the player holds the lump of coal
  phrase carried-sun when the player holds the minuature sun
  phrase carried-container when the player holds the radiation-proof container
  phrase carried-gloves when the player holds the space gloves
  phrase carried-box when the player holds the remote-control box
  phrase carried-bone when the player holds the bone
  phrase carried-cheese when the player holds the piece of cheese
  phrase carried-penny when the player holds the penny
  phrase carried-rat when the player holds the rat
  phrase carried-cat when the player holds the cat

  phrases en-US
    carried-me:
      Something valuable.
    carried-wire:
      Platinum wire.
    carried-uranium:
      Uranium in container.
    carried-statue:
      Ancient statue.
    carried-nuggets:
      Gold nuggets.
    carried-record:
      Gold record.
